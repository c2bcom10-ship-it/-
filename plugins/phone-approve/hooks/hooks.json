{
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/approve.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/approve.py\"",
            "timeout": 600
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/notify.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/notify.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/notify.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/notify.py\""
          }
        ]
      }
    ]
  }
}
